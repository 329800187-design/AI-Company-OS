# AI Company OS v1.5.0 - Environment Configuration
# Copy this file to .env and fill in your API keys

# ============================================
# AI Provider Selection
# Options: deepseek / openai / claude
# ============================================
AI_PROVIDER=deepseek

# ============================================
# DeepSeek Configuration (Recommended)
# Get API Key: https://platform.deepseek.com
# Price: ~0.1-0.3 RMB per 1000 requests
# ============================================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============================================
# OpenAI Configuration
# Get API Key: https://platform.openai.com
# Price: ~$0.005-0.03 per 1000 tokens
# ============================================
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ============================================
# Claude Configuration
# Get API Key: https://console.anthropic.com
# Price: ~$0.003-0.015 per 1000 tokens
# ============================================
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-sonnet-4-20250514

# ============================================
# Authentication (Optional)
# Leave empty to disable authentication
# For production: set a strong token
# ============================================
AUTH_TOKEN=
AUTH_ENABLED=false

# ============================================
# Server Configuration
# ============================================
HOST=0.0.0.0
PORT=8000
ENV=development

# ============================================
# Agent Configuration
# ============================================
CODEX_TIMEOUT=30
CODEX_MAX_OUTPUT=100000
OPENCLAW_HEADLESS=true
OPENCLAW_TIMEOUT=30

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_MAX_DAYS=7

# ============================================
# Cloud Mode Configuration
# ============================================
# Enable cloud mode to use cloud Agent Runtime
CLOUD_MODE=false
CLOUD_API_BASE=http://your-server.com/api
CLOUD_AUTH_TOKEN=
ALLOW_LOCAL_FALLBACK=true
ALLOW_USER_API_KEYS=false

# ============================================
# MiMo Configuration (联网搜索模型)
# ============================================
MIMO_API_KEY=
MIMO_BASE_URL=https://api.mimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
MIMO_ENABLE_WEB_SEARCH=true

# ============================================
# Boss Command Center Configuration
# ============================================
# Provider: local_mock / local_heuristic / hermes
# Default: local_heuristic (offline-safe, no browser automation)
BOSS_EXECUTION_PROVIDER=local_heuristic

# Hermes CLI configuration (only used when BOSS_EXECUTION_PROVIDER=hermes)
HERMES_CLI_PATH=hermes
HERMES_EXECUTION_TIMEOUT_SECONDS=180

# E-commerce mode for Hermes (requires Hermes to have ecommerce/sourcing skills)
# Default: false — must explicitly opt-in
HERMES_ECOMMERCE_MODE_ENABLED=false

# ============================================
# Browser Automation Approval Gate
# ============================================
# Require explicit user approval before any browser automation
# Default: true — all browser/Playwright/ecommerce collection needs approval
BROWSER_AUTOMATION_REQUIRE_APPROVAL=true

# Global approval flag (set to true to allow browser automation without per-request approval)
# Default: false — use API parameter allow_browser_automation=true for per-request approval
BROWSER_AUTOMATION_APPROVED=false

# ============================================
# Feishu / Lark Bot Integration
# ============================================
# Enable a Feishu self-built app bot as an AI Company OS group chat agent.
FEISHU_BOT_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Optional: copy from Feishu event subscription security settings.
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# Default true: only reply in group chats when mentioned.
FEISHU_REPLY_ONLY_MENTION=true
FEISHU_MAX_REPLY_CHARS=1800
FEISHU_CONNECTION_MODE=long_connection
